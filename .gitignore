# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Local configuration and secrets
.env
.streamlit/secrets.toml

# Runtime data at the project root only (never commit tenant data, databases or logs).
# Patterns are anchored with a leading slash so views/data/ and similar code folders are not ignored.
/data/
/storage/*
!/storage/.gitkeep
/logs/*
!/logs/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite3

# Offline speech models (downloaded separately)
/models/

# Build artifacts
/dist/
/build/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
