# Copy this file to .env and adjust. Every value is optional; the defaults
# shown here are what the application uses when a variable is not set.
# Never commit your real .env (it is git-ignored).

# --- Application ---------------------------------------------------------
APP_NAME=Voice-Enabled Data Analyst
APP_ENV=development
LOG_LEVEL=INFO
# Relative paths are resolved from the project folder.
DATABASE_PATH=data/app.db
BACKUP_DIR=data/backups
STORAGE_ROOT=storage
LOG_DIR=logs

# --- Sign-in and sessions --------------------------------------------------
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
# Argon2id cost (defaults follow RFC 9106 low-memory profile)
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_PARALLELISM=4

# --- Plan seed values and processing limits --------------------------------
# These seed the default Basic/Premium plans the first time the database is
# created; afterwards edit plans in the Super Admin panel.
BASIC_MAX_UPLOAD_MB=50
PREMIUM_MAX_UPLOAD_MB=500
# Global ceiling; also raise server.maxUploadSize in .streamlit/config.toml.
ABSOLUTE_UPLOAD_CEILING_MB=1024
# Engineering starting points. Benchmark on your machine before raising.
CSV_PROCESSING_TARGET_MB=250
XLSX_PROCESSING_TARGET_MB=100
APPEND_MERGE_INPUT_TARGET_MB=100
PREVIEW_MAX_ROWS=500
RESULT_MAX_ROWS=500
CSV_CHUNK_ROWS=50000
PARQUET_BATCH_ROWS=50000
# Fraction of the RAM available *right now* that one operation may use.
MEMORY_SAFETY_FRACTION=0.5
MIN_FREE_DISK_MB=500
EXCEL_MAX_UNCOMPRESSED_MB=1024
EXCEL_MAX_SHEETS=200
OPERATION_TIMEOUT_SECONDS=900
MERGE_MAX_OUTPUT_ROWS=20000000
# Widest dataset import, append and merge may create (columns).
MAX_COLUMNS=1000

# --- Data typing -------------------------------------------------------------
# Placeholders treated as missing at import, separated by "|".
DEFAULT_MISSING_PLACEHOLDERS=NA|N/A|null|NULL|None|NaN|nan|#N/A
# true = 05/01/2024 means 5 January (day first); false = 1 May (month first)
DEFAULT_DATE_DAYFIRST=false

# --- Local AI (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b
# Smaller quantized model used when OLLAMA_MODEL is not installed.
OLLAMA_FALLBACK_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_WAIT_SECONDS=5
# rules = answer common questions with the labelled rule-based interpreter when
# Ollama is unavailable; off = show an error instead.
AI_FALLBACK_MODE=rules
AI_NARRATIVE_ENABLED=true

# --- Optional cloud AI: Google Gemini instead of Ollama --------------------------
# ollama = local and private (default). gemini = Google's API, "schema only": each question
# (typed or spoken) and the column names and types are sent; data values and results are not.
# Free key: https://aistudio.google.com/apikey. On the free tier Google may use what you send
# to improve its products and people may read it; with billing enabled it does not.
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Voice -------------------------------------------------------------------
# Offline recognition: pip install -r requirements-optional.txt and unpack a
# model from https://alphacephei.com/vosk/models into this folder.
VOSK_MODEL_PATH=models/vosk
VOSK_MODEL_LANGUAGE=en-US
# Online recognition sends recordings to Google's speech service. Off by default.
VOICE_ONLINE_RECOGNITION_ENABLED=false
VOICE_DEFAULT_LANGUAGE=en-US
VOICE_SUPPORTED_LANGUAGES=en-US|en-IN|en-GB|hi-IN
VOICE_MAX_SECONDS=60
VOICE_MIN_SECONDS=0.4
VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=30

# --- E-mail alerts (SMTP) ----------------------------------------------------
# Leave SMTP_HOST empty to disable e-mail (alerts are still recorded).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Use STARTTLS (port 587) or implicit SSL (port 465), not both.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
ALERT_DEFAULT_COOLDOWN_MINUTES=60
